# Variables para docker-compose.yml (PC del taller, uso real).
# Copiar a ".env" en esta misma carpeta y completar con valores reales antes
# de "docker compose up". Sin este archivo, el compose usa valores de
# desarrollo inseguros por defecto — no usar así en producción.

# Contraseña del único administrador del panel.
ADMIN_PASSWORD=elegir-una-contrasena-real

# Clave para firmar los tokens de sesión (JWT). Cualquier cadena larga y
# aleatoria sirve; no hace falta recordarla, solo que no cambie mientras
# haya sesiones activas. Generarla una vez y no compartirla.
JWT_SECRET=generar-una-cadena-larga-aleatoria-unica
