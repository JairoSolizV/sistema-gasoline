// Esquema basado en docs/MODELO_DATOS_TALLER.md (Anexo B) con dos ajustes
// documentados en docs/PLAN_IMPLEMENTACION.md §6:
//  - Todos los montos son Int en CENTAVOS de Bs (ARQUITECTURA §3.1); se
//    formatean a Bs solo en presentación. Ej.: ct=15 significa Bs 0.15.
//  - `n` es opcional: el seed real trae operaciones sin número de paso.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoOperario {
  regular
  maestro_externo
  proveedor_externo // serigrafía, láser, bordado o lavandería de afuera, cobra por prenda (docs/PLAN_CUENTAS_SEPARADAS.md §5)
}

enum PasoCorte {
  mesa // cortado, en la mesa
  costura
  lavanderia
  empaque
  deposito // terminado, listo para despachar
}

enum EstadoCorte {
  borrador
  abierto
  cerrado
}

enum EstadoCorteOp {
  sin_asignar
  parcial
  asignada
}

enum EstadoPeriodo {
  abierto
  cerrado
}

enum RolOperario {
  costurero
  cortador
  doblador
  moldista // creador de moldes / patronaje
  buscador // buscador de diseño
  trazador
  clasificador // clasificador y codificador de piezas
  ayudante // sueldo semanal + asistencia; también recibe operaciones (docs/PLAN_AYUDANTES.md)
  lavanderia // solo proveedores externos (docs/PLAN_CUENTAS_SEPARADAS.md §5)
  bordado // solo proveedores externos
  serigrafia // solo proveedores externos
  laser // solo proveedores externos
}

model Operario {
  id            String        @id @default(uuid())
  nombre        String
  tipo          TipoOperario  @default(regular)
  activo        Boolean       @default(true)
  // Oficios (uno o varios). Restringen en qué selectores aparece el operario
  // (docs/PLAN_SERVICIO_CORTE.md §3). Maestro externo NO es un rol: es el `tipo`.
  roles               RolOperario[] @default([costurero])
  // Tarifas personales (centavos/prenda) según habilidad/velocidad; se precargan
  // al elegirlo en un corte. null = usar el respaldo de Configuración.
  tarifaCorte         Int?
  tarifaClasificacion Int?
  // Proveedor externo: precio por prenda predeterminado de cada servicio; se
  // copia al envío del corte y ahí se puede cambiar.
  tarifaLavanderia    Int?
  tarifaBordado       Int?
  tarifaSerigrafia    Int?
  tarifaLaser         Int?
  // Datos personales: obligatorios en el alta (validado en la API), opcionales
  // en BD porque el roster original del seed no los trae.
  ci              String?       @unique // cédula de identidad, normalizada a mayúsculas
  celular         String?
  fechaNacimiento DateTime?
  fechaIngreso  DateTime      @default(now())
  fechaSalida   DateTime? // salida prevista/pactada; informativa, NO da de baja
  fechaBaja     DateTime? // la fija el sistema al dar de baja (activo=false)
  asignaciones  Asignacion[]
  anticipos     Anticipo[]
  liquidaciones Liquidacion[]
  trabajosCorte   TrabajoCorte[]
  modelosBuscados Modelo[]    @relation("ModeloBuscador")
  pagosMolde      PagoMolde[]
  sueldos         SueldoAyudante[]
  asistencias     Asistencia[]
  envios          EnvioServicio[] // como proveedor externo de lavandería o bordado
}

model Modelo {
  id        String          @id @default(uuid())
  nombre    String          @unique
  activo    Boolean         @default(true)
  versiones ModeloVersion[]
  // Búsqueda del diseño (docs/PLAN_SERVICIO_CORTE.md §2.8): quien lo encontró
  // cobra tarifaBusqueda × prenda en cada corte interno de este modelo. O se
  // marca sinBuscador (modelo del cliente / anterior al módulo): no se paga y
  // no bloquea el cierre. Ninguno de los dos = pendiente (bloquea el cierre).
  buscador    Operario? @relation("ModeloBuscador", fields: [buscadorId], references: [id])
  buscadorId  String?
  sinBuscador Boolean   @default(false)
  fichasCosto FichaCosto[] // costos (docs/PLAN_COSTOS.md); solo consulta
}

model ModeloVersion {
  id                  String      @id @default(uuid())
  modelo              Modelo      @relation(fields: [modeloId], references: [id])
  modeloId            String
  numeroVersion       Int
  notas               String?
  // derivado: suma de ct de sus operaciones, en centavos (cacheado al guardar)
  costoManoObraPrenda Int         @default(0)
  activa              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  operaciones         Operacion[]
  cortes              Corte[]
  molde               PagoMolde? // moldes de ESTA versión (v1 = nuevo, otras = modificación)

  @@unique([modeloId, numeroVersion])
}

model Operacion {
  id              String           @id @default(uuid())
  version         ModeloVersion    @relation(fields: [modeloVersionId], references: [id])
  modeloVersionId String
  orden           Int
  grupo           String
  n               String? // número de paso; sub-pasos como "7.1" → texto; a veces vacío
  equipo          String
  proceso         String
  pieza           String?
  ct              Int // centavos por pieza
  // operación de empaque (botón, remache, cuero, deshilachado, embolsado…):
  // se paga igual que la costura pero se muestra aparte (docs/PLAN_AYUDANTES.md)
  esEmpaque       Boolean          @default(false)
  copias          CorteOperacion[]
}

model Corte {
  id              String           @id @default(uuid())
  version         ModeloVersion    @relation(fields: [modeloVersionId], references: [id])
  modeloVersionId String
  // Numeración del corte (N° 1, 2, 3…): automática (máximo + 1) si no se
  // indica, editable, nunca repetida. Informativo; no entra al cálculo.
  codigo          Int              @unique
  tallas         Json // referencia visual; NO entra al cálculo
  cortePorTalla   Json
  plusPorTalla    Json
  cantidadTotal   Int // = Σ corte_por_talla + Σ plus_por_talla; base de todo el pago
  // Datos del tendido (informativos, NO entran al cálculo de pagos). Obligatorios
  // al crear (validado en la API); opcionales en BD por cortes anteriores.
  tela            String?
  anchoCm         Int? // ancho de la tela, en cm (se ingresa en metros con 2 decimales)
  trazadoCm       Int? // largo del trazado, en cm
  prendasPorCapa  Int? // prendas que salen por capa del trazado (costos: tela real = largo × capas)
  // Calculadora de tendido (informativa): metros de cada rollo (cm, en orden),
  // traslape de cada empalme y retazo mínimo útil. Las hojas y retazos que
  // sobran se calculan al vuelo (shared/src/tendido.ts). null = sin cargar.
  rollosCm        Json?
  traslapeCm      Int?
  retazoMinimoCm  Int?
  // Servicio de corte interno (docs/PLAN_SERVICIO_CORTE.md). Un corte externo
  // (llega cortado de afuera) no paga ningún proceso.
  esInterno       Boolean          @default(true)
  // Snapshot de las tarifas predeterminadas de Configuración al crear el corte
  // (centavos). Cambiar Configuración después NO las altera. null en externos.
  tarifaBusqueda              Int?
  tarifaTrazado               Int?
  tarifaDobladoHoja           Int? // total del proceso por prenda (2 dobladores)
  tarifaDobladoPares          Int?
  tarifaCorteRespaldo         Int? // por persona, si el cortador no tiene tarifa propia
  tarifaClasificacionRespaldo Int?
  modalidadDoblado            ModalidadDoblado?
  trabajos                    TrabajoCorte[]
  envios                      EnvioServicio[] // lavandería y bordado externos
  estado          EstadoCorte      @default(borrador)
  fechaInicio     DateTime         @default(now())
  fechaCierre     DateTime? // se fija al cerrar; eje del consolidado
  operaciones     CorteOperacion[]
  cambios         CorteCambio[]
  // dónde está físicamente (docs/PLAN_DIDACTICO_REPORTES.md): lo marca una persona
  // con un botón. Informativo: no toca pagos ni el estado del corte.
  paso            PasoCorte        @default(mesa)
  pasoDesde       DateTime         @default(now())
  pedidos         Pedido[] // tablero de dinero: pedidos que se producen con este corte
  despachos       DespachoLinea[] // prendas de este corte que salieron del depósito

  @@index([estado, fechaCierre])
}

// Snapshot pagable: copia congelada de una Operacion al abrir el corte.
// Editar tarifas de la versión NO altera cortes ya creados (CA-1.4).
model CorteOperacion {
  id                String        @id @default(uuid())
  corte             Corte         @relation(fields: [corteId], references: [id])
  corteId           String
  operacionOrigen   Operacion?    @relation(fields: [operacionOrigenId], references: [id], onDelete: SetNull)
  operacionOrigenId String?
  orden             Int
  grupo             String
  n                 String?
  equipo            String
  proceso           String
  pieza             String?
  ct                Int // centavos, congelado al abrir el corte
  esEmpaque         Boolean       @default(false) // congelado al abrir, como el ct
  // segundos por prenda del catálogo, congelado al abrir (solo para el estimado
  // de duración; no afecta pagos). null = el catálogo no tenía tiempo.
  tiempoSeg         Int?
  cantidadObjetivo  Int // lo que debe sumar la asignación (suma exacta)
  estado            EstadoCorteOp @default(sin_asignar)
  asignaciones      Asignacion[]
  cambios           CorteCambio[]

  @@index([corteId, estado])
}

enum TipoCambioCorte {
  reordenar
  editar
  agregar
  quitar
}

// Historial de modificaciones de último momento a las operaciones de UN corte
// (máquina que se fregó, operación extra…). Solo tocan el snapshot del corte,
// nunca el modelo. Se registra en la misma transacción que el cambio.
model CorteCambio {
  id                String           @id @default(uuid())
  corte             Corte            @relation(fields: [corteId], references: [id], onDelete: Cascade)
  corteId           String
  // null al quitar la operación (el historial la describe en `etiqueta`/`detalle`)
  corteOperacion    CorteOperacion?  @relation(fields: [corteOperacionId], references: [id], onDelete: SetNull)
  corteOperacionId  String?
  tipo              TipoCambioCorte
  grupo             String
  etiqueta          String // "proceso · pieza" al momento del cambio
  // editar: { campos: [{ campo, antes, despues }] } · agregar/quitar: { operacion }
  // reordenar: { antes: string[], despues: string[] } (etiquetas del grupo)
  detalle           Json
  fecha             DateTime         @default(now())

  @@index([corteId, fecha])
}

model Asignacion {
  id               String         @id @default(uuid())
  corteOperacion   CorteOperacion @relation(fields: [corteOperacionId], references: [id])
  corteOperacionId String
  operario         Operario       @relation(fields: [operarioId], references: [id])
  operarioId       String
  cantidad         Int
  esMaestroExterno Boolean        @default(false)
  diferencial      Int            @default(0) // centavos; 10 por defecto si maestro externo (editable)
  tarifaEfectiva   Int // centavos = ct + diferencial
  total            Int // centavos = cantidad × tarifaEfectiva (aritmética entera exacta)

  @@index([operarioId])
}

model Anticipo {
  id         String   @id @default(uuid())
  operario   Operario @relation(fields: [operarioId], references: [id])
  operarioId String
  cuenta     Cuenta   @default(operaciones) // solo descuenta del saldo de esta cuenta
  fecha      DateTime
  monto      Int // centavos; si supera el tope → advertencia, no bloqueo
  nota       String?
  caja       Caja     @default(efectivo) // de qué caja salió (docs/PLAN_CAJA.md); no entra al cálculo

  @@index([operarioId, fecha])
}

model Periodo {
  id            String        @id @default(uuid())
  anio          Int
  mes           Int
  estado        EstadoPeriodo @default(abierto)
  fechaCierre   DateTime?
  liquidaciones Liquidacion[]

  @@unique([anio, mes])
}

model Liquidacion {
  id             String   @id @default(uuid())
  periodo        Periodo  @relation(fields: [periodoId], references: [id])
  periodoId      String
  operario       Operario @relation(fields: [operarioId], references: [id])
  operarioId     String
  // una fila por operario y CUENTA: los saldos de cuentas distintas no se
  // mezclan ni se compensan (docs/PLAN_CUENTAS_SEPARADAS.md §3)
  cuenta         Cuenta
  saldoEntrada   Int      @default(0) // centavos; arrastre del mes anterior en esta cuenta (puede ser negativo)
  totalGanado    Int      @default(0) // ganado del mes en esta cuenta
  totalAnticipos Int      @default(0) // anticipos del mes cargados a esta cuenta
  saldoPeriodo   Int      @default(0) // = saldoEntrada + totalGanado − totalAnticipos
  pagado         Int      @default(0)
  arrastraSaldo  Boolean  @default(false)
  saldoSalida    Int      @default(0) // 0 si se liquidó todo; pasa a saldoEntrada del siguiente (misma cuenta)

  @@unique([periodoId, operarioId, cuenta])
}

// Cuentas de pago separadas (docs/PLAN_CUENTAS_SEPARADAS.md §2): cada una con
// su ganado, anticipos, saldo y arrastre por operario.
enum Cuenta {
  operaciones // costura (operaciones del corte que no son de empaque)
  empaque
  servicio_corte // búsqueda, trazado, doblado, corte y clasificación
  moldes
  sueldo // sueldo semanal de ayudantes
  lavanderia // proveedor externo, por prenda
  bordado // proveedor externo, por prenda
  serigrafia // proveedor externo, por prenda
  laser // proveedor externo, por prenda
}

model Configuracion {
  id                        Int     @id @default(1)
  topeAnticipoAdvertencia   Int     @default(200000) // centavos (Bs 2000.00)
  diferencialMaestroExterno Int     @default(10) // centavos (Bs 0.10)
  redondeoDecimales         Int     @default(2)
  nombreTaller              String?

  // Servicio de corte interno (docs/PLAN_SERVICIO_CORTE.md). Centavos. Son los
  // PREDETERMINADOS: al crear un corte se copian al corte (snapshot) y ahí se
  // editan; cambiarlos acá no toca cortes ya creados.
  tarifaBusqueda              Int @default(10) // por prenda, al buscador del modelo, en cada corte
  tarifaMoldeNuevo            Int @default(20000) // monto fijo, una vez por modelo nuevo
  tarifaMoldeModificacion     Int @default(5000) // monto fijo, por versión con moldes modificados
  tarifaTrazado               Int @default(30) // por prenda
  tarifaDobladoHoja           Int @default(15) // por prenda, TOTAL del proceso (se reparte en 2)
  tarifaDobladoPares          Int @default(10) // por prenda, TOTAL del proceso (se reparte en 2)
  tarifaCorteRespaldo         Int @default(15) // por prenda y por cortador sin tarifa propia
  tarifaClasificacionRespaldo Int @default(10) // por prenda y por clasificador sin tarifa propia

  // Costos (docs/PLAN_COSTOS.md): margen general del precio de venta, en
  // centésimas de % (30 % = 3000); cada ficha puede tener el suyo.
  margenVenta                 Int @default(3000)
  // costos fijos (docs/PLAN_COSTOS.md §7c): prendas por mes con las que se reparte el
  // costo fijo en las fichas (el mínimo de producción: precio seguro)
  prendasMesCostoFijo         Int @default(1500)
  // costos: tipo de cambio para mostrar precios por docena en $us (diezmilésimos;
  // 11.85 = 118 500). Solo para mostrar; no cambia ningún cálculo en Bs.
  tasaCambioUsd               Int @default(118500)
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo: jerarquía Máquina → Proceso → Pieza (dentro de cada operación) +
// Grupos (los bloques que envuelven a esas operaciones, sin filtrarlas)
// (docs/PLAN_CATALOGO_MAQUINAS.md). Es una AYUDA DE CAPTURA para el alta de
// modelos: `Operacion` y `CorteOperacion` siguen guardando texto y no tienen
// FK a estas tablas, porque el snapshot pagable no puede depender de una fila
// viva del catálogo (CA-1.4 / PLAN §2.1). Sin precios: el CT es siempre manual.
// ─────────────────────────────────────────────────────────────────────────────

model Maquina {
  id        String    @id @default(uuid())
  nombre    String    @unique // normalizado a minúsculas: "recta", "overlock"
  orden     Int       @default(0)
  activo    Boolean   @default(true) // baja lógica; nunca borrado si está en uso
  createdAt DateTime  @default(now())
  procesos  Proceso[]
}

model Proceso {
  id        String   @id @default(uuid())
  maquina   Maquina  @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  maquinaId String
  nombre    String // minúsculas: "pinza", "despunte"
  orden     Int      @default(0)
  // segundos por prenda (estimado). La pieza puede tener el suyo, que manda.
  tiempoSeg Int?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  piezas    Pieza[]

  @@unique([maquinaId, nombre]) // "pinza" puede existir en recta y en plana
  @@index([maquinaId, activo])
}

model Pieza {
  id        String   @id @default(uuid())
  proceso   Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  procesoId String
  nombre    String // minúsculas: "trasero", "bolsillo"
  orden     Int      @default(0)
  tiempoSeg Int? // segundos por prenda; si falta se usa el del proceso
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([procesoId, nombre])
  @@index([procesoId, activo])
}

// Grupos: los bloques que envuelven a las operaciones de un modelo (TRASEROS,
// DELANTEROS…). No cuelgan de Maquina ni nada cuelga de ellos: elegir un grupo
// NO limita qué máquina/proceso/pieza se puede usar.
model Grupo {
  id        String   @id @default(uuid())
  nombre    String   @unique // MAYÚSCULAS: "TRASEROS", "ENSAMBLE"
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  // bloque reutilizable: las operaciones estándar del grupo. Al crear o editar
  // un modelo se agregan todas de una vez (y ahí se ajustan).
  operaciones GrupoOperacion[]
}

// Una operación del bloque estándar de un grupo. Como en las plantillas, guarda
// el texto (sin FK al catálogo) y un CT de REFERENCIA opcional: el CT que se
// paga es el que queda escrito en cada modelo.
model GrupoOperacion {
  id           String  @id @default(uuid())
  grupo        Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  grupoId      String
  orden        Int
  n            String? // número de paso dentro del grupo
  equipo       String
  proceso      String
  pieza        String?
  ctReferencia Int? // centavos; precio sugerido (null = sin referencia)
  esEmpaque    Boolean @default(false)

  @@index([grupoId, orden])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plantillas de modelo: la receta de operaciones de una prenda típica (el
// pantalón clásico y las variantes que salgan de duplicarla). Al crear un
// modelo se copian sus filas al formulario con el CT precargado.
//
// Cada operación guarda un CT de REFERENCIA (opcional): es solo una sugerencia.
// El CT que vale es el que queda escrito en cada modelo, porque la misma
// operación vale distinto según la prenda; cambiar la referencia después no
// toca ningún modelo ni corte.
// ─────────────────────────────────────────────────────────────────────────────

model Plantilla {
  id          String               @id @default(uuid())
  nombre      String               @unique
  notas       String?
  // la del pantalón clásico: se puede editar, no borrar
  protegida   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  operaciones PlantillaOperacion[]
}

model PlantillaOperacion {
  id           String    @id @default(uuid())
  plantilla    Plantilla @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  plantillaId  String
  orden        Int
  grupo        String
  n            String? // número de paso dentro del grupo
  equipo       String
  proceso      String
  pieza        String?
  // centavos; precio sugerido al crear un modelo (null = sin referencia)
  ctReferencia Int?
  esEmpaque    Boolean   @default(false)

  @@index([plantillaId, orden])
}

// Pago por moldes / patronaje (docs/PLAN_SERVICIO_CORTE.md §2.9). A lo sumo uno
// por versión: la v1 es "nuevo" (Bs 200) y las siguientes "modificacion" (Bs 50),
// solo si se marcó que se modificaron los moldes. Se paga UNA vez, en la `fecha`
// (define la semana/mes de la liquidación). `monto` se fija al registrarlo.
enum TipoMolde {
  nuevo
  modificacion
}

model PagoMolde {
  id              String        @id @default(uuid())
  version         ModeloVersion @relation(fields: [modeloVersionId], references: [id], onDelete: Cascade)
  modeloVersionId String        @unique
  operario        Operario      @relation(fields: [operarioId], references: [id])
  operarioId      String
  tipo            TipoMolde
  monto           Int // centavos
  fecha           DateTime
  createdAt       DateTime      @default(now())

  @@index([fecha])
}

// ── Servicio de corte interno: procesos pagados por corte ────────────────────
enum ProcesoCorte {
  busqueda // al buscador del modelo, en cada corte
  trazado
  doblado
  corte
  clasificacion // clasificación y codificación de piezas
}

enum ModalidadDoblado {
  hoja // por hoja / cara: se estira, se corta y se vuelve a estirar cara arriba
  pares // por pares: continuo, una cara arriba y otra abajo
}

// Una fila por persona y proceso. `total` se fija al guardar (inmutable, como
// Asignacion.total) y se paga en la `fecha` en que se terminó el proceso (no al
// cerrar el corte). Doblado: `tarifa` es la del proceso completo y el total se
// reparte en 2 con el centavo sobrante al primero anotado (orden 1).
model TrabajoCorte {
  id         String       @id @default(uuid())
  corte      Corte        @relation(fields: [corteId], references: [id], onDelete: Cascade)
  corteId    String
  proceso    ProcesoCorte
  operario   Operario     @relation(fields: [operarioId], references: [id])
  operarioId String
  orden      Int // 1, 2, 3 dentro del proceso (en doblado define quién lleva el centavo)
  tarifa     Int // centavos por prenda que se aplicó
  cantidad   Int // prendas del corte (cantidad total, PLUS incluido)
  total      Int // centavos
  fecha      DateTime

  @@unique([corteId, proceso, operarioId])
  @@index([fecha])
}

// ── Ayudantes: sueldo semanal con historial (docs/PLAN_AYUDANTES.md) ─────────
// El sueldo vigente para un día es el último con vigenteDesde ≤ ese día; así
// "se ajusta cada mes" sin perder lo anterior. Fechas sin hora (@db.Date).
model SueldoAyudante {
  id           String   @id @default(uuid())
  operario     Operario @relation(fields: [operarioId], references: [id], onDelete: Cascade)
  operarioId   String
  montoSemanal Int // centavos por semana completa (lunes a sábado)
  vigenteDesde DateTime @db.Date
  createdAt    DateTime @default(now())

  @@unique([operarioId, vigenteDesde])
}

// ── Ayudantes: asistencia diaria (docs/PLAN_AYUDANTES.md §2-3) ───────────────
// Un registro por ayudante y día (lunes a sábado). El sueldo del día sale de
// minutosPagados (shared/sueldo.ts): trabajo = 540 − descontados − operaciones,
// falta = 0, feriado = 540. Es historial de pago: impide eliminar al operario.
enum EstadoAsistencia {
  trabajo
  falta
  feriado
}

model Asistencia {
  id                 String           @id @default(uuid())
  operario           Operario         @relation(fields: [operarioId], references: [id])
  operarioId         String
  fecha              DateTime         @db.Date
  estado             EstadoAsistencia
  minutosDescontados Int              @default(0) // atrasos y salidas antes de hora
  minutosOperaciones Int              @default(0) // horas de horario en operaciones (se pagan aparte)
  nota               String?
  updatedAt          DateTime         @updatedAt

  @@unique([operarioId, fecha])
  @@index([fecha])
}

// ── Servicios externos: lavandería, bordado, serigrafía y láser (docs/PLAN_CUENTAS_SEPARADAS.md §5) ─────────
// Envío de prendas de un corte a un proveedor externo. Se paga por prenda y se
// GANA en la fecha de devolución (un envío sin devolver no paga), en la cuenta
// del servicio. Un corte puede tener varios envíos del mismo servicio.
enum ServicioExterno {
  lavanderia
  bordado
  serigrafia
  laser
}

model EnvioServicio {
  id              String          @id @default(uuid())
  corte           Corte           @relation(fields: [corteId], references: [id])
  corteId         String
  servicio        ServicioExterno
  operario        Operario        @relation(fields: [operarioId], references: [id]) // el proveedor
  operarioId      String
  cantidad        Int // prendas enviadas
  precioPrenda    Int // centavos; se copia del proveedor y se puede cambiar
  total           Int // centavos = cantidad × precioPrenda
  fechaEnvio      DateTime        @db.Date
  fechaDevolucion DateTime?       @db.Date // null = todavía no volvió
  nota            String?
  creadoEn        DateTime        @default(now())

  @@index([corteId])
  @@index([fechaDevolucion])
}

// ── Costos de producción (docs/PLAN_COSTOS.md) ───────────────────────────────
// SOLO CONSULTA: nada de esto entra a los pagos. Cantidades en milésimas de su
// unidad, dinero en centavos, tasa de cambio en diezmilésimos (shared/costos.ts).
enum CategoriaInsumo {
  tela
  hilo
  cierre
  boton
  remache
  cuero
  etiqueta
  bolsa
  logistica // saco, yute…
  otro
}

enum CondicionCompra {
  contado
  credito
}

enum OrigenCompra {
  fabrica
  mayorista
  tienda
}

enum MonedaCompra {
  BOB
  USD
}

enum TipoLineaCosto {
  por_prenda // cantidad de un insumo por prenda
  tela_tizado // largo del tizado ÷ prendas por capa
  hilo // precio del cono ÷ prendas que rinde
  prorrateo // monto ÷ prendas (flete, pasajes…)
  precio_prenda // precio directo por prenda (lavandería, bordado…)
}

model Insumo {
  id          String          @id @default(uuid())
  nombre      String
  categoria   CategoriaInsumo
  unidad      String // metro, cono, unidad…
  color       String?
  codigo      String?
  titulo      String? // hilo: ej. 20/3
  anchoCm     Int? // tela
  marca       String? // cierre
  numeroLlave String? // cierre
  medidaCm    Int? // cierre
  rendimiento Int? // hilo: prendas que rinde un cono (base; la ficha puede tener el suyo)
  notas       String?
  activo      Boolean         @default(true)
  creadoEn    DateTime        @default(now())
  compras     CompraInsumo[]
  conteos     ConteoInsumo[]
  lineas      LineaCosto[]
}

// El costo usa el precio de la ÚLTIMA compra del insumo.
model CompraInsumo {
  id           String       @id @default(uuid())
  insumo       Insumo       @relation(fields: [insumoId], references: [id])
  insumoId     String
  fecha        DateTime     @db.Date
  tienda       String
  origen       OrigenCompra @default(tienda)
  ciudad       String?
  presentacion String? // ej. "paquete de 144"
  cantidad     Int // milésimas de la unidad del insumo
  moneda       MonedaCompra @default(BOB)
  montoUsd     Int? // centavos de $us (compra en dólares)
  tasaCambio   Int? // diezmilésimos: tasa oficial del día de la compra
  precioTotal  Int // centavos Bs (en dólares: montoUsd × tasa, redondeado una vez)
  condicion    CondicionCompra @default(contado) // a crédito: suma a la deuda con el proveedor (tablero)
  vence        DateTime?       @db.Date // a crédito: cuándo hay que pagarla (cuentas por pagar)
  caja         Caja            @default(efectivo) // al contado: de qué caja salió
  codigoCorte  String? // corte para el que se compró (texto: "28-1"; los cortes 25–32 no están en el sistema)
  notas        String?
  creadoEn     DateTime     @default(now())

  @@index([insumoId, fecha])
}

// Ficha de costo por prenda. Vinculada a un modelo de Taller · Pagos, la mano de
// obra y el empaque salen de los CT de su última versión; sin vincular, a mano.
model FichaCosto {
  id                   String       @id @default(uuid())
  codigo               String? // el del catálogo local (ej. "31")
  nombre               String       @unique
  modelo               Modelo?      @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  modeloId             String?
  manoDeObra           Int? // centavos por prenda; solo sin modelo vinculado
  empaque              Int? // idem
  servicioCorteInterno Boolean      @default(true) // suma las tarifas del servicio de corte
  margen               Int? // centésimas de %; null = el general de Configuración
  precioDocenaUsd      Int? // precio fijo de la docena en $us (centavos); null = costo + margen
  notas                String?
  // catálogo de productos: lo que se le muestra al cliente
  tallas               String? // ej. "28 al 38"
  colores              String? // ej. "azul, negro, celeste"
  descripcion          String?
  foto                 FotoFicha?
  creadoEn             DateTime     @default(now())
  actualizadoEn        DateTime     @updatedAt
  lineas               LineaCosto[]
  planes               PlanProduccion[]
  pedidos              Pedido[]
  despachos            DespachoLinea[]
}

model LineaCosto {
  id             String         @id @default(uuid())
  ficha          FichaCosto     @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId        String
  orden          Int
  tipo           TipoLineaCosto
  concepto       String
  insumo         Insumo?        @relation(fields: [insumoId], references: [id])
  insumoId       String? // por_prenda, tela_tizado, hilo
  cantidad       Int? // por_prenda: milésimas por prenda
  largoMm        Int? // tela_tizado
  prendasPorCapa Int? // tela_tizado
  rendimiento    Int? // hilo: prendas por cono en ESTE modelo (null = el del insumo)
  monto          Int? // prorrateo: centavos
  prendas        Int? // prorrateo: entre cuántas prendas
  precio         Int? // precio_prenda: centavos

  @@index([fichaId, orden])
}

// Conteo físico de un insumo (docs/PLAN_COSTOS.md §7b): el stock parte del
// último conteo y suma compras y resta consumo de cortes posteriores.
model ConteoInsumo {
  id       String   @id @default(uuid())
  insumo   Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  insumoId String
  fecha    DateTime @db.Date
  cantidad Int // milésimas de la unidad del insumo
  notas    String?
  creadoEn DateTime @default(now())

  @@index([insumoId, fecha])
}

// Plan de producción del mes: cuántas prendas de cada ficha (proyección).
model PlanProduccion {
  id      String     @id @default(uuid())
  anio    Int
  mes     Int
  ficha   FichaCosto @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId String
  prendas Int

  @@unique([anio, mes, fichaId])
}

// ── Costos fijos del taller (docs/PLAN_COSTOS.md §7c) — solo consulta ────────
enum GrupoGastoFijo {
  personal // sueldo de los dueños, comida del personal…
  operativos // transporte…
  servicios // CRE, Saguapac, YPFB, Tigo
  maquinas // mantenimiento, agujas, depreciación
  impuestos
  otros
}

enum TipoGastoFijo {
  mensual // un monto por mes (con historial)
  por_compras // la suma de las compras anotadas en el mes (ej. comida)
}

// Un gasto fijo del taller. Si se comparte con la casa (mismo medidor, la
// comida), solo cuenta su porcentaje del taller.
model GastoFijo {
  id               String          @id @default(uuid())
  nombre           String          @unique
  grupo            GrupoGastoFijo
  tipo             TipoGastoFijo   @default(mensual)
  porcentajeTaller Int             @default(10000) // centésimas de % (100 % = 10 000)
  activo           Boolean         @default(true)
  notas            String?
  creadoEn         DateTime        @default(now())
  montos           GastoFijoMonto[]
  compras          CompraGasto[]
}

// Monto mensual desde una fecha (como el sueldo de los ayudantes: rige el
// último que ya empezó).
model GastoFijoMonto {
  id           String    @id @default(uuid())
  gasto        GastoFijo @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  gastoId      String
  monto        Int // centavos por mes (total, antes del % del taller)
  vigenteDesde DateTime  @db.Date

  @@unique([gastoId, vigenteDesde])
}

// Una compra de un gasto "por compras" (verduras, pan, carne…; sin factura).
model CompraGasto {
  id       String    @id @default(uuid())
  gasto    GastoFijo @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  gastoId  String
  fecha    DateTime  @db.Date
  monto    Int // centavos (total de la compra, antes del % del taller)
  nota     String?
  caja     Caja      @default(efectivo)
  creadoEn DateTime  @default(now())

  @@index([gastoId, fecha])
}

// Préstamo bancario: la cuota completa se carga como costo fijo
// ("recuperación de deuda"); aviso en Inicio antes de cada vencimiento.
model Prestamo {
  id              String         @id @default(uuid())
  banco           String
  cuota           Int // centavos por mes
  diaVencimiento  Int // 1..31 (si el mes es más corto, el último día)
  cuotasRestantes Int? // informativo
  activo          Boolean        @default(true)
  notas           String?
  creadoEn        DateTime       @default(now())
  pagos           PagoPrestamo[]
}

model PagoPrestamo {
  id         String   @id @default(uuid())
  prestamo   Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  prestamoId String
  anio       Int
  mes        Int
  fecha      DateTime @db.Date
  monto      Int // centavos
  caja       Caja     @default(efectivo)

  @@unique([prestamoId, anio, mes])
}

// ── Tablero de dinero (docs/PLAN_TABLERO_DINERO.md) — no toca pagos ───────────

// Pago a un proveedor de insumos (ej. la tela a crédito). La deuda de cada
// proveedor = compras a crédito − pagos; el proveedor es el nombre de la tienda
// de la compra, normalizado (mayúsculas, sin espacios de más).
model PagoProveedor {
  id        String   @id @default(uuid())
  proveedor String
  fecha     DateTime     @db.Date
  moneda    MonedaCompra @default(BOB) // en $us sale de la caja de dólares (docs/PLAN_DOLARES.md)
  monto     Int // centavos de su moneda
  nota      String?
  caja      Caja         @default(efectivo)
  creadoEn  DateTime     @default(now())

  @@index([proveedor])
}

model Cliente {
  id        String     @id @default(uuid())
  nombre    String     @unique
  celular   String?
  notas     String?
  plazoDias Int        @default(30) // días para pagar un despacho (0 = al contado)
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now())
  pedidos   Pedido[]
  despachos Despacho[]
  cobros    Cobro[]
}

enum EstadoPedido {
  pendiente // en puerta: todavía no se cortó
  en_produccion // ya tiene corte
  entregado
  cancelado
}

// Pedido de un cliente: "modelos en puerta". El precio se copia del precio de
// venta de la ficha y se puede cambiar.
model Pedido {
  id           String       @id @default(uuid())
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  clienteId    String
  ficha        FichaCosto   @relation(fields: [fichaId], references: [id])
  fichaId      String
  prendas         Int
  precioDocenaUsd Int // centavos de $us por docena (docs/PLAN_DOLARES.md)
  fechaEntrega    DateTime?    @db.Date
  estado          EstadoPedido @default(pendiente)
  corte        Corte?       @relation(fields: [corteId], references: [id])
  corteId      String?
  notas        String?
  creadoEn     DateTime     @default(now())

  @@index([estado])
}

// Prendas que salen del depósito hacia un cliente. Se cobra con Cobro.
model Despacho {
  id        String          @id @default(uuid())
  cliente   Cliente         @relation(fields: [clienteId], references: [id])
  clienteId String
  fecha     DateTime        @db.Date
  vence      DateTime        @db.Date // cuándo lo tiene que pagar (fecha + plazo del cliente, editable)
  tasaCambio Int // diezmilésimos: Bs por $us del día (para la ganancia en Bs)
  notas      String?
  creadoEn  DateTime        @default(now())
  lineas    DespachoLinea[]

  @@index([fecha])
}

// Una línea es de un corte (descuenta su depósito) o de una ficha (prendas que
// no pasaron por el sistema). costoPrenda es una FOTO al despachar (costo real
// del corte o de la ficha, sin costos fijos): el resultado de meses pasados no
// cambia si después cambian los precios.
model DespachoLinea {
  id           String      @id @default(uuid())
  despacho     Despacho    @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  despachoId   String
  corte        Corte?      @relation(fields: [corteId], references: [id])
  corteId      String?
  ficha        FichaCosto? @relation(fields: [fichaId], references: [id])
  fichaId      String?
  descripcion  String
  detalle      String? // talla y color cuando no va surtido (ej. "12 de la 30 negro")
  prendas         Int
  precioDocenaUsd Int // centavos de $us por docena
  totalUsd        Int // centavos de $us = prendas × precio docena ÷ 12 (un redondeo)
  totalBs         Int // centavos de Bs = totalUsd × tasa del despacho (para la ganancia)
  costoPrenda     Int // centavos de Bs (foto)
}

model Cobro {
  id        String   @id @default(uuid())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String
  fecha      DateTime     @db.Date
  moneda     MonedaCompra @default(USD) // casi siempre en dólares (docs/PLAN_DOLARES.md)
  monto      Int // centavos de su moneda
  tasaCambio Int // diezmilésimos del día
  usd        Int // equivalente en $us (lo que descuenta de la deuda del cliente)
  bs         Int // equivalente en Bs
  nota       String?
  caja       Caja         @default(dolares) // en $us: la caja de dólares
  creadoEn   DateTime     @default(now())

  @@index([clienteId])
}

// ── Caja (docs/PLAN_CAJA.md) — no toca pagos ─────────────────────────────────

enum Caja {
  efectivo
  banco // cuenta bancaria, transferencias y QR
  dolares // cobros en $us; de acá se paga la tela en $us (docs/PLAN_DOLARES.md)
}

// Desde cuándo se lleva cada caja y con cuánto empezó: lo anterior no cuenta.
model CajaInicio {
  caja         Caja     @id
  desde        DateTime @db.Date
  saldoInicial Int // centavos
}

enum TipoCategoriaCaja {
  ingreso
  egreso
}

// Categoría para clasificar ingresos y gastos. Las que tienen clave las usa el
// sistema para lo que entra solo (cobros, compras, anticipos…): se pueden
// renombrar pero no desactivar.
model CategoriaCaja {
  id          String            @id @default(uuid())
  nombre      String            @unique
  tipo        TipoCategoriaCaja
  clave       String?           @unique
  activo      Boolean           @default(true)
  orden       Int               @default(0)
  movimientos MovimientoCaja[]
}

enum TipoMovimientoCaja {
  ingreso
  egreso
  transferencia // de una caja a la otra (ej. depositar efectivo en el banco)
}

// Movimiento anotado a mano (lo que no se registra en otra pantalla).
model MovimientoCaja {
  id          String             @id @default(uuid())
  tipo        TipoMovimientoCaja
  caja        Caja // de dónde sale o adónde entra
  cajaDestino Caja? // solo transferencias
  fecha       DateTime           @db.Date
  monto       Int // centavos de la moneda de `caja`
  // cambio de dólares (transferencia entre la caja de $us y una de Bs): lo que
  // entra en la otra moneda y a qué tipo de cambio
  montoDestino Int?
  tasaCambio   Int?
  categoria   CategoriaCaja?     @relation(fields: [categoriaId], references: [id])
  categoriaId String? // null en transferencias
  descripcion String
  creadoEn    DateTime           @default(now())

  @@index([fecha])
}

// Conteo de la plata real: la diferencia con el sistema queda como ajuste.
model ArqueoCaja {
  id         String   @id @default(uuid())
  caja       Caja
  fecha      DateTime @db.Date
  contado    Int // centavos
  sistema    Int // lo que decía el sistema ese día (foto)
  diferencia Int // contado − sistema (positivo = sobrante)
  nota       String?
  creadoEn   DateTime @default(now())

  @@index([caja, fecha])
}

// Foto del producto para el catálogo. Se guarda en la base (entra en los
// respaldos); el panel la achica a ≤1000 px antes de subirla.
model FotoFicha {
  ficha         FichaCosto @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       String     @id
  mime          String
  datos         Bytes
  actualizadoEn DateTime   @updatedAt
}
